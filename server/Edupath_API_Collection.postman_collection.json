{
  "info": {
    "name": "Edupath API Collection",
    "description": "Complete API collection for Edupath application including Auth, Prodi, and Universitas endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "edupath-api"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"John\",\n  \"lastname\": \"Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"kelas\": \"12\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": ["{{base_url}}"],
              "path": ["auth", "register"]
            }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (responseCode.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.environment.set('auth_token', jsonData.token);",
                  "    pm.globals.set('auth_token', jsonData.token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/login",
              "host": ["{{base_url}}"],
              "path": ["auth", "login"]
            }
          }
        },
        {
          "name": "Get Current User",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/auth/me",
              "host": ["{{base_url}}"],
              "path": ["auth", "me"]
            }
          }
        },
        {
          "name": "Send OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/send-otp",
              "host": ["{{base_url}}"],
              "path": ["auth", "send-otp"]
            }
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"john.doe@example.com\",\n  \"newPassword\": \"newpassword123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/forgot-password",
              "host": ["{{base_url}}"],
              "path": ["auth", "forgot-password"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{auth_token}}",
                  "type": "string"
                }
              ]
            },
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstname\": \"John Updated\",\n  \"lastname\": \"Doe Updated\",\n  \"kelas\": \"12\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/update-profile",
              "host": ["{{base_url}}"],
              "path": ["auth", "update-profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Program Studi (Prodi)",
      "item": [
        {
          "name": "Search Prodi by Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prodi/search/nama/teknik informatika",
              "host": ["{{base_url}}"],
              "path": ["prodi", "search", "nama", "teknik informatika"]
            }
          }
        },
        {
          "name": "Get Prodi Detail by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prodi/detail/CTJUaJKjJj4Tw94HsltWe0AB0-iuX1hs2gVqXQg0zkHnDk_JhSrPe7arNq88Kb88RLT3hw==",
              "host": ["{{base_url}}"],
              "path": ["prodi", "detail", "CTJUaJKjJj4Tw94HsltWe0AB0-iuX1hs2gVqXQg0zkHnDk_JhSrPe7arNq88Kb88RLT3hw=="]
            }
          }
        },
        {
          "name": "Get Jenjang List",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prodi/jenjang",
              "host": ["{{base_url}}"],
              "path": ["prodi", "jenjang"]
            }
          }
        },
        {
          "name": "List Prodi with Filters",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/prodi?q=teknik&jenjang=S1&bidang=teknologi&page=1&limit=20",
              "host": ["{{base_url}}"],
              "path": ["prodi"],
              "query": [
                {
                  "key": "q",
                  "value": "teknik"
                },
                {
                  "key": "jenjang",
                  "value": "S1"
                },
                {
                  "key": "bidang",
                  "value": "teknologi"
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Universitas",
      "item": [
        {
          "name": "Get All Universitas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/universitas",
              "host": ["{{base_url}}"],
              "path": ["universitas"]
            }
          }
        },
        {
          "name": "Search Universitas by Name",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/universitas/search/nama?nama=gadjah mada",
              "host": ["{{base_url}}"],
              "path": ["universitas", "search", "nama"],
              "query": [
                {
                  "key": "nama",
                  "value": "gadjah mada"
                }
              ]
            }
          }
        },
        {
          "name": "Get Universitas by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/universitas/12345",
              "host": ["{{base_url}}"],
              "path": ["universitas", "12345"]
            }
          }
        }
      ]
    }
  ]
}
