generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id          String    @id @default(uuid())
  firstname   String
  lastname    String
  email       String    @unique
  password    String
  kelas       Int // kelas sebagai angka: 10, 11, 12
  otp         String?
  otp_expires DateTime?
  created_at  DateTime  @default(now())
}
