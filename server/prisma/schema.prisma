generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
    ADMIN // Guru BK/Admin
    STUDENT // Murid
}

model User {
    user_id    String   @id
    firstname  String
    lastname   String
    email      String   @unique
    password   String
    role       Role     @default(STUDENT)
    kelas      Int?
    created_at DateTime @default(now())
}

model Universitas {
    university_id Int     @id
    nama          String
    npsn          Int
    nama_singkat  String?
    kode_pos      Int
    telepon       String
    email         String
    alamat        String
    kota          String
    provinsi      String
    akreditasi    String
    status        String
    rank_qs       Int?
    rank_country  Int?
}
