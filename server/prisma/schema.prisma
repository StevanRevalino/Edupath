generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN // Guru BK/Admin
  STUDENT // Murid
}

model User {
  user_id    String   @id
  firstname  String
  lastname   String
  email      String   @unique
  password   String
  role       Role     @default(STUDENT)
  kelas      Int?
  created_at DateTime @default(now())
}
