generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  user_id              String             @id
  firstname            String
  lastname             String
  email                String             @unique
  password             String
  role                 Role               @default(STUDENT)
  kelas                Int?
  created_at           DateTime           @default(now())
  sentMessages         ChatMessage[]      @relation("ChatMessageSender")
  chatRoomsAsAdmin     ChatRoom[]         @relation("ChatRoomAdmin")
  chatRoomsAsMurid     ChatRoom[]         @relation("ChatRoomMurid")
  consultationsAsAdmin Consultation[]     @relation("ConsultationAdmin")
  consultationsAsMurid Consultation[]     @relation("ConsultationMurid")
  riasecAssessments    RiasecAssessment[]
  notifications        Notification[]
  zoomMeetingsAsHost   ZoomMeeting[]      @relation("ZoomMeetingHost")
}

model Universitas {
  university_id Int       @id
  nama          String
  npsn          String?
  nama_singkat  String?
  kode_pos      String?
  telepon       String?
  fax           String?
  email         String?
  alamat        String?
  kota          String?
  provinsi      String?
  akreditasi    String?
  status        String?
  rank_qs       String?
  rank_country  String?
  created_at    DateTime  @default(now())
  prodi_pt      ProdiPT[]

  @@index([nama])
  @@index([provinsi])
  @@index([kota])
}

model Prodi {
  prodi_id              Int                    @id
  nama_prodi            String
  jenjang               String?
  created_at            DateTime               @default(now())
  prodi_pt              ProdiPT[]
  riasecMappings        RiasecProdiMapping[]
  riasecRecommendations RiasecRecommendation[]

  @@index([nama_prodi])
  @@index([jenjang])
}

model ProdiPT {
  id               Int         @id @default(autoincrement())
  prodi_id         Int
  university_id    Int
  akreditasi_prodi String?
  ukt_min          String?
  ukt_max          String?
  link_prodi       String?
  created_at       DateTime    @default(now())
  prodi            Prodi       @relation(fields: [prodi_id], references: [prodi_id], onDelete: Cascade)
  universitas      Universitas @relation(fields: [university_id], references: [university_id], onDelete: Cascade)

  @@unique([prodi_id, university_id])
  @@index([prodi_id])
  @@index([university_id])
}

model Consultation {
  consultation_id   String             @id
  murid_id          String
  admin_id          String
  topic             String
  consultation_date DateTime
  description       String?
  admin_notes       String?
  status            ConsultationStatus @default(PENDING)
  is_active         Boolean            @default(true)
  created_at        DateTime           @default(now())
  chatRoom          ChatRoom?
  zoomMeetings      ZoomMeeting[]
  admin             User               @relation("ConsultationAdmin", fields: [admin_id], references: [user_id], onDelete: Cascade)
  murid             User               @relation("ConsultationMurid", fields: [murid_id], references: [user_id], onDelete: Cascade)

  @@index([murid_id])
  @@index([admin_id])
  @@index([status])
  @@index([consultation_date])
  @@index([is_active])
}

model ChatRoom {
  room_id         String        @id @default(cuid())
  consultation_id String        @unique
  murid_id        String
  admin_id        String
  created_at      DateTime      @default(now())
  updated_at      DateTime      @updatedAt
  messages        ChatMessage[]
  admin           User          @relation("ChatRoomAdmin", fields: [admin_id], references: [user_id], onDelete: Cascade)
  consultation    Consultation  @relation(fields: [consultation_id], references: [consultation_id], onDelete: Cascade)
  murid           User          @relation("ChatRoomMurid", fields: [murid_id], references: [user_id], onDelete: Cascade)

  @@index([murid_id])
  @@index([admin_id])
}

model ChatMessage {
  message_id String   @id @default(cuid())
  room_id    String
  sender_id  String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())
  chatRoom   ChatRoom @relation(fields: [room_id], references: [room_id], onDelete: Cascade)
  sender     User     @relation("ChatMessageSender", fields: [sender_id], references: [user_id], onDelete: Cascade)

  @@index([room_id])
  @@index([sender_id])
  @@index([created_at])
}

model Beasiswa {
  beasiswa_id String   @id @default(cuid())
  title       String
  image_url   String
  link        String
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([created_at])
}

model Notification {
  notification_id String   @id @default(cuid())
  user_id         String
  type            String
  title           String
  message         String
  is_read         Boolean  @default(false)
  related_id      String?
  link            String?
  created_at      DateTime @default(now())
  user            User     @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@index([user_id])
  @@index([is_read])
  @@index([created_at])
}

model ZoomMeeting {
  zoom_meeting_id  String       @id @default(cuid())
  meeting_id       String       @unique
  consultation_id  String
  host_id          String
  topic            String
  scheduled_time   DateTime
  description      String?
  meeting_password String
  status           ZoomStatus   @default(scheduled)
  created_at       DateTime     @default(now())
  updated_at       DateTime     @updatedAt
  consultation     Consultation @relation(fields: [consultation_id], references: [consultation_id], onDelete: Cascade)
  host             User         @relation("ZoomMeetingHost", fields: [host_id], references: [user_id], onDelete: Cascade)

  @@index([consultation_id])
  @@index([host_id])
  @@index([scheduled_time])
  @@index([status])
}

enum Role {
  ADMIN
  STUDENT
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

enum ZoomStatus {
  scheduled
  started
  ended
  cancelled
}

// RIASEC Assessment models
enum RiasecType {
  REALISTIC
  INVESTIGATIVE
  ARTISTIC
  SOCIAL
  ENTERPRISING
  CONVENTIONAL
}

model RiasecQuestion {
  question_id   Int              @id @default(autoincrement())
  question_text String
  riasec_type   RiasecType
  created_at    DateTime         @default(now())
  responses     RiasecResponse[]

  @@index([riasec_type])
}

model RiasecAssessment {
  assessment_id       String                 @id @default(cuid())
  user_id             String
  realistic_score     Int                    @default(0)
  investigative_score Int                    @default(0)
  artistic_score      Int                    @default(0)
  social_score        Int                    @default(0)
  enterprising_score  Int                    @default(0)
  conventional_score  Int                    @default(0)
  primary_type        RiasecType
  secondary_type      RiasecType?
  holland_code        String
  completed_at        DateTime               @default(now())
  user                User                   @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  responses           RiasecResponse[]
  recommendations     RiasecRecommendation[]

  @@index([user_id])
  @@index([primary_type])
  @@index([completed_at])
}

model RiasecResponse {
  response_id   String           @id @default(cuid())
  assessment_id String
  question_id   Int
  answer_value  Int
  created_at    DateTime         @default(now())
  assessment    RiasecAssessment @relation(fields: [assessment_id], references: [assessment_id], onDelete: Cascade)
  question      RiasecQuestion   @relation(fields: [question_id], references: [question_id], onDelete: Cascade)

  @@unique([assessment_id, question_id])
  @@index([assessment_id])
  @@index([question_id])
}

model RiasecProdiMapping {
  mapping_id          Int         @id @default(autoincrement())
  prodi_id            Int
  primary_type        RiasecType
  secondary_type      RiasecType?
  compatibility_score Int         @default(100)
  created_at          DateTime    @default(now())
  prodi               Prodi       @relation(fields: [prodi_id], references: [prodi_id], onDelete: Cascade)

  @@index([primary_type])
  @@index([secondary_type])
  @@index([prodi_id])
}

model RiasecRecommendation {
  recommendation_id String           @id @default(cuid())
  assessment_id     String
  prodi_id          Int
  match_percentage  Float
  rank              Int
  created_at        DateTime         @default(now())
  assessment        RiasecAssessment @relation(fields: [assessment_id], references: [assessment_id], onDelete: Cascade)
  prodi             Prodi            @relation(fields: [prodi_id], references: [prodi_id], onDelete: Cascade)

  @@index([assessment_id])
  @@index([prodi_id])
  @@index([rank])
}
