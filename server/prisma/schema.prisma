generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ADMIN // Guru BK/Admin
  STUDENT // Murid
}

model User {
  user_id    String   @id
  firstname  String
  lastname   String
  email      String   @unique
  password   String
  role       Role     @default(STUDENT)
  kelas      Int?
  created_at DateTime @default(now())

  // Consultation relationships
  consultationsAsMurid Consultation[] @relation("ConsultationMurid")
  consultationsAsAdmin Consultation[] @relation("ConsultationAdmin")

  // Chat relationships
  chatRoomsAsMurid ChatRoom[]    @relation("ChatRoomMurid")
  chatRoomsAsAdmin ChatRoom[]    @relation("ChatRoomAdmin")
  sentMessages     ChatMessage[] @relation("ChatMessageSender")
}

model Universitas {
  university_id Int       @id
  nama          String
  npsn          String?
  nama_singkat  String?
  kode_pos      String?
  telepon       String?
  fax           String?
  email         String?
  alamat        String?
  kota          String?
  provinsi      String?
  akreditasi    String?
  status        String?
  rank_qs       String?
  rank_country  String?
  created_at    DateTime  @default(now())
  prodi_pt      ProdiPT[]

  @@index([nama])
  @@index([provinsi])
  @@index([kota])
}

model Prodi {
  prodi_id   Int       @id
  nama_prodi String
  jenjang    String?
  created_at DateTime  @default(now())
  prodi_pt   ProdiPT[]

  @@index([nama_prodi])
  @@index([jenjang])
}

model ProdiPT {
  id               Int      @id @default(autoincrement())
  prodi_id         Int
  university_id    Int
  akreditasi_prodi String?
  ukt_min          String?
  ukt_max          String?
  link_prodi       String?
  created_at       DateTime @default(now())

  prodi       Prodi       @relation(fields: [prodi_id], references: [prodi_id], onDelete: Cascade)
  universitas Universitas @relation(fields: [university_id], references: [university_id], onDelete: Cascade)

  @@unique([prodi_id, university_id])
  @@index([prodi_id])
  @@index([university_id])
}

enum ConsultationStatus {
  PENDING
  ACCEPTED
  DECLINED
  COMPLETED
}

model Consultation {
  consultation_id   String             @id
  murid_id          String
  admin_id          String
  topic             String
  consultation_date DateTime
  notes             String?
  status            ConsultationStatus @default(PENDING)
  is_active         Boolean            @default(true)
  created_at        DateTime           @default(now())

  murid User @relation("ConsultationMurid", fields: [murid_id], references: [user_id], onDelete: Cascade)
  admin User @relation("ConsultationAdmin", fields: [admin_id], references: [user_id], onDelete: Cascade)

  // Relationship to chat room
  chatRoom ChatRoom?

  @@index([murid_id])
  @@index([admin_id])
  @@index([status])
  @@index([consultation_date])
  @@index([is_active])
}

// Chat Room model - represents a conversation between a student and admin
model ChatRoom {
  room_id         String   @id @default(cuid())
  consultation_id String   @unique
  murid_id        String
  admin_id        String
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  updated_at      DateTime @updatedAt

  // Relationships
  consultation Consultation  @relation(fields: [consultation_id], references: [consultation_id], onDelete: Cascade)
  murid        User          @relation("ChatRoomMurid", fields: [murid_id], references: [user_id], onDelete: Cascade)
  admin        User          @relation("ChatRoomAdmin", fields: [admin_id], references: [user_id], onDelete: Cascade)
  messages     ChatMessage[]

  @@index([murid_id])
  @@index([admin_id])
  @@index([is_active])
}

// Chat Message model - individual messages in a chat room
model ChatMessage {
  message_id String   @id @default(cuid())
  room_id    String
  sender_id  String
  message    String
  is_read    Boolean  @default(false)
  created_at DateTime @default(now())

  // Relationships
  chatRoom ChatRoom @relation(fields: [room_id], references: [room_id], onDelete: Cascade)
  sender   User     @relation("ChatMessageSender", fields: [sender_id], references: [user_id], onDelete: Cascade)

  @@index([room_id])
  @@index([sender_id])
  @@index([created_at])
}

// Scholarship/Beasiswa model
model Beasiswa {
  beasiswa_id String   @id @default(cuid())
  title       String
  image_url   String // Cloudinary URL
  link        String // Link to medsos/website universitas
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  @@index([created_at])
}
